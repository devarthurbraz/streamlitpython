4️⃣ Falar direto com um Vendedor Humano

Como posso te ajudar hoje?
"""

# ==========================================
# 3. FUNÇÃO DE RESERVA (Nova Regra de Datas)
# ==========================================
def realizar_reserva(id_produto, nome_cliente):
    if id_produto in estoque_colchoes:
        produto = estoque_colchoes[id_produto]
        
        if produto["status"] == "disponivel":
            # 1. Pega o momento atual
            agora = datetime.datetime.now()
            
            # 2. Soma 2 dias à data atual
            prazo_final = agora + datetime.timedelta(days=2)
            
            # 3. Identifica o dia da semana (5 = Sábado, 6 = Domingo)
            dia_semana = prazo_final.weekday()
            
            # 4. Se o prazo cair no final de semana, joga para segunda-feira
            if dia_semana == 5:  # Sábado
                prazo_final += datetime.timedelta(days=2)
            elif dia_semana == 6:  # Domingo
                prazo_final += datetime.timedelta(days=1)
                
            # 5. Fixa rigorosamente o horário para as 18:00h
            prazo_final = prazo_final.replace(hour=18, minute=0, second=0, microsecond=0)
            
            # Atualiza os dados do dicionário do produto
            produto["status"] = "reservado"
            produto["reservado_para"] = nome_cliente
            produto["limite_reserva"] = prazo_final.strftime("%d/%m/%Y às %H:%M")
            
            print(f"\n✅ REQUISIÇÃO ACEITA PELO PYTHON:")
            print(f"Sucesso! O '{produto['nome']}' foi reservado para {nome_cliente}.")
            print(f"⏳ O cliente tem até o dia {produto['limite_reserva']} para ir à loja testar.")
            print(f"📲 NOTIFICAÇÃO ENVIADA AO SEU SOGRO: 'Venda Híbrida Iniciada!'")
        else:
            print("\n❌ Erro: Esse colchão já está reservado por outro cliente.")
    else:
        print("\n❌ Erro: Código de produto inválido.")

